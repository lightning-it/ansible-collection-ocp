---
apiVersion: v1
kind: ConfigMap
metadata:
  labels:
    app.kubernetes.io/managed-by: openshift-gitops
    app.kubernetes.io/name: argocd-tls-certs-cm
    app.kubernetes.io/part-of: argocd
  name: argocd-tls-certs-cm
  namespace: openshift-gitops
data:
{% for item in gitops_bootstrap_tls_certs %}
  "{{ item.url | regex_replace('^https?://', '') | regex_replace('/.*$', '') | regex_replace(':\\d+$', '') }}": |-
{{ item.cert | indent(4, true) }}
{% endfor %}
